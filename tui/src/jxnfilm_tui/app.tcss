/* Palette lifted from the club's css/tokens.css so the TUI reads as the same
   product as the audiograms it renders: ink #100f0e, brand red #d7321f,
   rule grey #3a352d. */

Screen {
    background: #100f0e;
}

.pane-title {
    background: #1a1815;
    color: #d7321f;
    text-style: bold;
    padding: 0 1;
    width: 100%;
}

.note {
    padding: 0 1;
    color: #8a8378;
}

/* NOT docked: Footer already docks bottom, and a second bottom-docked widget
   lands in the same row and gets painted over. This sits in the flow instead,
   just above it. */
.status {
    height: 1;
    width: 100%;
    padding: 0 1;
    background: #1a1815;
}

#tabs {
    height: 1fr;
}

.command {
    padding: 1;
    background: #16130f;
    color: #cfc6b8;
    border: round #3a352d;
    margin: 1 0 0 0;
}

/* --- rounds tab --------------------------------------------------------- */

#rounds-split {
    height: 1fr;
}

#rounds-col {
    width: 34%;
    border-right: solid #3a352d;
}

#clips-col {
    width: 1fr;
}

#detail-box {
    height: 40%;
    border-top: solid #3a352d;
    padding: 1 2;
}

/* --- kv tab ------------------------------------------------------------- */

#kv-split {
    height: 1fr;
}

#kv-prefixes {
    width: 26;
    border-right: solid #3a352d;
}

#kv-keys {
    width: 40%;
    border-right: solid #3a352d;
}

#kv-value {
    width: 1fr;
    padding: 0 1;
}

#kv-value-body {
    padding: 1 0;
}

/* --- modals ------------------------------------------------------------- */

ActionPicker, LaunchScreen {
    align: center middle;
}

#picker-box, #launch-box {
    width: 84;
    height: auto;
    max-height: 90%;
    background: #16130f;
    border: round #d7321f;
    padding: 1 2;
}

/* Summaries are a sentence long — let each row grow to fit rather than
   clipping the half that explains what the action does. */
#action-list {
    height: auto;
    max-height: 24;
    margin: 1 0;
    background: transparent;
}

#action-list ListItem {
    height: auto;
    padding: 0 1 1 1;
    background: transparent;
}

#launch-options {
    max-height: 18;
    margin: 1 0;
}

.opt-row {
    height: 3;
    align: left middle;
}

.opt-label {
    width: 22;
    padding: 1 0;
}

.opt-help {
    padding: 0 0 1 22;
    color: #8a8378;
}

#launch-buttons {
    height: 3;
    margin: 1 0 0 0;
}

#launch-buttons Button {
    margin: 0 1 0 0;
}

/* --- run screen --------------------------------------------------------- */

#run-box {
    height: 1fr;
    padding: 0 1;
}

#run-output {
    height: 1fr;
    border: round #3a352d;
    background: #16130f;
}
